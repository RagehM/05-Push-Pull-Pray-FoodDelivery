{
  "id": null,
  "uid": "delivery-service",
  "title": "Delivery Service Dashboard",
  "tags": ["talabat", "delivery"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 10,
      "type": "logs",
      "title": "[LogQL] All Logs — {app=\"talabat\", service=\"delivery-service\"}",
      "description": "Raw full log stream for the delivery-service.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{app=\"talabat\", service=\"delivery-service\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "[LogQL] Log Volume by Level — delivery-service",
      "description": "Rate of INFO / WARN / ERROR logs over time.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (level) (rate({app=\"talabat\", service=\"delivery-service\"}[1m]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "[LogQL] Saga Tracking — delivery lifecycle by orderId",
      "description": "Traces the complete delivery saga flow filtered by orderId.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"talabat\", service=\"delivery-service\"} | json | orderId != \"\" | line_format \"[{{.level}}] orderId={{.orderId}} deliveryId={{.deliveryId}} status={{.status}} — {{.message}}\""
        }
      ]
    },
    {
      "id": 13,
      "title": "[LogQL] Error Rate — delivery-service",
      "description": "ERROR-level log lines per minute from delivery-service.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({app=\"talabat\", service=\"delivery-service\", level=\"ERROR\"}[1m]))",
          "legendFormat": "errors/min"
        }
      ]
    },
    {
      "id": 14,
      "title": "[LogQL] RabbitMQ Event Audit — delivery-service",
      "description": "Events published and consumed by delivery-service filtered by routing key.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"talabat\", service=\"delivery-service\"} | json | routingKey =~ `delivery\\\\..+|order\\\\..+`"
        }
      ]
    },
    {
      "id": 20,
      "title": "[PromQL] HTTP Request Rate — Delivery Service",
      "description": "Requests per second per endpoint.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri, method, status) (rate(http_server_requests_seconds_count{job=\"delivery-service\"}[5m]))",
          "legendFormat": "{{method}} {{uri}} [{{status}}]"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 21,
      "title": "[PromQL] HTTP Latency P99 — Delivery Service",
      "description": "P99 request latency per endpoint.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"delivery-service\"}[5m])) by (le, uri))",
          "legendFormat": "P99 {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 22,
      "title": "[PromQL] HikariCP Active Connections — Delivery Service",
      "description": "Active database connections from the connection pool.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"delivery-service\"}",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2
          }
        }
      }
    }
  ]
}