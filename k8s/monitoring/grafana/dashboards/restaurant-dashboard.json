{
  "title": "Restaurant Service Dashboard",
  "uid": "restaurant-service",
  "tags": ["talabat", "restaurant"],
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate — Restaurant Service",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"restaurant-service\"}[5m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ],
      "description": "Requests per second per endpoint — shows load on restaurant-service"
    },
    {
      "id": 2,
      "title": "HTTP Latency P99 — Restaurant Service",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=\"restaurant-service\"}[5m])) by (le, uri))",
          "legendFormat": "P99 {{uri}}"
        }
      ],
      "description": "P99 latency per endpoint — detects slow Feign-enriched dashboard/summary responses"
    },
    {
      "id": 3,
      "title": "JVM Heap Usage — Restaurant Service",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"restaurant-service\", area=\"heap\"}",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "jvm_memory_max_bytes{job=\"restaurant-service\", area=\"heap\"}",
          "legendFormat": "Heap Max"
        }
      ],
      "description": "JVM heap — alert if used approaches max"
    },
    {
      "id": 4,
      "title": "Error Rate — Restaurant Service",
      "type": "timeseries",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "count_over_time({service=\"restaurant-service\", level=\"ERROR\"}[1m])",
          "legendFormat": "Errors/min"
        }
      ],
      "description": "ERROR log lines per minute — spike means saga consumer or Feign failure"
    },
    {
      "id": 5,
      "title": "RabbitMQ Event Audit — Restaurant Service",
      "type": "timeseries",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "count_over_time({service=\"restaurant-service\"} |= \"Published\" [5m])",
          "legendFormat": "Events Published"
        },
        {
          "expr": "count_over_time({service=\"restaurant-service\"} |= \"Consuming\" [5m])",
          "legendFormat": "Events Consumed"
        }
      ],
      "description": "Published vs consumed event counts per 5 min — detects consumer lag"
    },
    {
      "id": 6,
      "title": "Feign Call Outcomes — Restaurant Service",
      "type": "timeseries",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "count_over_time({service=\"restaurant-service\"} |= \"returned successfully\" [5m])",
          "legendFormat": "Feign Success"
        },
        {
          "expr": "count_over_time({service=\"restaurant-service\"} |= \"Feign call to\" |= \"failed\" [5m])",
          "legendFormat": "Feign Failures"
        }
      ],
      "description": "Detects when order-service is degraded from restaurant-service perspective"
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s"
}
