{
  "id": null,
  "uid": "checkout-service",
  "title": "Checkout Service Dashboard",
  "tags": ["talabat", "checkout"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 10,
      "type": "logs",
      "title": "[LogQL] All Logs — {app=\"talabat\", service=\"checkout-service\"}",
      "description": "Raw full log stream for the checkout-service. Every line emitted by every class is visible here.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{app=\"talabat\", service=\"checkout-service\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "[LogQL] Log Volume by Level — checkout-service",
      "description": "Rate of log lines per minute broken down by level (INFO / WARN / ERROR). Spikes in ERROR or WARN indicate problems.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (level) (rate({app=\"talabat\", service=\"checkout-service\"}[1m]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      }
    },

    {
      "id": 12,
      "type": "logs",
      "title": "[LogQL] WARN & ERROR Logs — checkout-service",
      "description": "Only WARN and ERROR lines. Covers: slow cuisine analytics, Feign failures, saga processing errors, unknown message types.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{app=\"talabat\", service=\"checkout-service\", level=~\"WARN|ERROR\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },

    {
      "id": 13,
      "type": "logs",
      "title": "[LogQL] HTTP Controller Logs — Received & Returning",
      "description": "Every inbound request log (\"Received METHOD /path\") and its outgoing response log (\"Returning STATUS for METHOD /path\") across OfferController, PaymentController, and PaymentOfferController.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{app=\"talabat\", service=\"checkout-service\"} | json | message =~ \"Received|Returning\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "[PromQL] HTTP Request Rate — /api/payments/**",
      "description": "Requests per second per endpoint. Shows which payment endpoints are under the most load.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (uri, method, status) (rate(http_server_requests_seconds_count{job=\"checkout-service\"}[5m]))",
          "legendFormat": "{{method}} {{uri}} [{{status}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "[PromQL] HTTP Latency P50 / P95 / P99 — /api/payments/process",
      "description": "P99 latency on POST /api/payments/process reveals slow payment gateway simulation or lock contention.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"checkout-service\", uri=~\"/api/payments/process.*\"}[5m])))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"checkout-service\", uri=~\"/api/payments/process.*\"}[5m])))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"checkout-service\", uri=~\"/api/payments/process.*\"}[5m])))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "[PromQL] HikariCP Connection Pool — Active vs Max",
      "description": "Pool exhaustion alert: checkout-service using all connections during saga fan-out triggers 503s.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"checkout-service\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_max{job=\"checkout-service\"}",
          "legendFormat": "Max",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{job=\"checkout-service\"}",
          "legendFormat": "Pending",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "[PromQL] JVM Heap Memory Usage",
      "description": "Memory pressure before OOM — checkout-service heap growth after processing many saga events.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"checkout-service\", area=\"heap\"}",
          "legendFormat": "Heap Used — {{id}}",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{job=\"checkout-service\", area=\"heap\"}",
          "legendFormat": "Heap Max — {{id}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2 }
        }
      }
    }
  ]
}

