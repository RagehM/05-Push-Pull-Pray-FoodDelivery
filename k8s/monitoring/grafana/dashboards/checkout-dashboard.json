{
  "id": null,
  "uid": "checkout-service",
  "title": "Checkout Service Dashboard",
  "tags": ["talabat", "checkout"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "[PromQL] HTTP Request Rate — /api/payments/**",
      "description": "Requests per second per endpoint. Shows which payment endpoints are under the most load.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (uri, method, status) (rate(http_server_requests_seconds_count{job=\"checkout-service\"}[5m]))",
          "legendFormat": "{{method}} {{uri}} [{{status}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "[PromQL] HTTP Latency P50 / P95 / P99 — /api/payments/process",
      "description": "P99 latency on POST /api/payments/process reveals slow payment gateway simulation or lock contention.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"checkout-service\", uri=~\"/api/payments/process.*\"}[5m])))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"checkout-service\", uri=~\"/api/payments/process.*\"}[5m])))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"checkout-service\", uri=~\"/api/payments/process.*\"}[5m])))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "[PromQL] HikariCP Connection Pool — Active vs Max",
      "description": "Pool exhaustion alert: checkout-service using all connections during saga fan-out triggers 503s.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"checkout-service\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_max{job=\"checkout-service\"}",
          "legendFormat": "Max",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{job=\"checkout-service\"}",
          "legendFormat": "Pending",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "[PromQL] JVM Heap Memory Usage",
      "description": "Memory pressure before OOM — checkout-service heap growth after processing many saga events.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"checkout-service\", area=\"heap\"}",
          "legendFormat": "Heap Used — {{id}}",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{job=\"checkout-service\", area=\"heap\"}",
          "legendFormat": "Heap Max — {{id}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "[PromQL] Redis Cache Hit Rate — S5-F10 Cuisine Analytics",
      "description": "Verify the S5-F10 cuisine analytics cache is reducing Feign call load.",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(cache_gets_total{job=\"checkout-service\", result=\"hit\"}[5m])) / sum(rate(cache_gets_total{job=\"checkout-service\"}[5m]))",
          "legendFormat": "Hit Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red",    "value": 0   },
              { "color": "yellow", "value": 0.5 },
              { "color": "green",  "value": 0.8 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "[LogQL] Error Rate — checkout-service",
      "description": "Count of ERROR-level log lines per minute. Spike indicates payment processing or saga failures.",
      "gridPos": { "x": 8, "y": 16, "w": 16, "h": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(rate({app=\"talabat\", service=\"checkout-service\", level=\"ERROR\"}[1m]))",
          "legendFormat": "Errors/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "[LogQL] RabbitMQ Event Audit — payment.events",
      "description": "Lines emitted by saga publishers and consumers filtered by payment routing keys.",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"talabat\", service=\"checkout-service\"} | json | routingKey =~ \"payment\\\\.*\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "[LogQL] Saga State Transitions — payment saga per orderId",
      "description": "Filter all payment saga log lines by orderId to trace the complete payment flow.",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"talabat\", service=\"checkout-service\"} | json | orderId != \"\" | line_format \"[{{.level}}] orderId={{.orderId}} paymentId={{.paymentId}} routingKey={{.routingKey}} — {{.message}}\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }
  ]
}

